---
import Layout from "../layouts/Layout.astro";
import { SONGS } from "../data/songs";
import {
  ALIGN_KEY,
  chordsForTonic,
  distinctChordNames,
  type Degree,
} from "../lib/chords";

// Real cover art (one per exhibit A–E) + the front-page press photo. Imported
// as ESM assets so Vite hashes them under the deploy base path — a hard-coded
// path would 404 on …github.io/<repo>/. Order matches SONGS (index 0 → A).
import coverA from "../images/cover-a-im-yours.jpg";
import coverB from "../images/cover-b-where-is-the-love.jpg";
import coverC from "../images/cover-c-someone-like-you.jpg";
import coverD from "../images/cover-d-with-or-without-you.jpg";
import coverE from "../images/cover-e-she-will-be-loved.jpg";
import heroPress from "../images/hero-press.jpg";

const COVERS = [coverA, coverB, coverC, coverD, coverE];

// The keys the visitor can transpose every song to. Conventional lead-sheet
// spellings (mixed sharps/flats) so the shared-key readout matches how a
// musician would write it — the same order chords.ts uses internally.
const KEYS = [
  "C",
  "Db",
  "D",
  "Eb",
  "E",
  "F",
  "F#",
  "G",
  "Ab",
  "A",
  "Bb",
  "B",
] as const;

// Degree order is the thesis: every song, every key, always I → V → vi → IV.
const ROMANS = ["I", "V", "vi", "IV"] as const;

// The split-state headline: how many DIFFERENT chord names the five songs print
// when each is in its own key. Derived from the exact same source as the cells
// (chordLabelsForTonic, via distinctChordNames), so the server-rendered no-JS
// number can never disagree with what align.ts recomputes on first render.
const SPLIT_DISTINCT_COUNT = distinctChordNames(
  SONGS.map((song) => song.tonic),
).length;

// What each chord *does* — its role is degree-based, so it's identical in every
// key and every song. Keyed on degree, this copy is rendered once per chord and
// revealed on demand (hover / focus / tap); it is NEVER written into
// [data-chord-label], which align.ts owns and overwrites on every align.
const ROLE_COPY: Record<Degree, string> = {
  I: "Home. Where the song rests.",
  V: "Tension. It leans forward, wanting to resolve.",
  vi: "The turn. The wistful, minor-key step.",
  IV: "The lift. It opens the song back up.",
};

// Exhibit letters A–E map from song index 0→A … 4→E.
const EXHIBIT = (index: number) => String.fromCharCode(65 + index);

// "Write your own hit" — the songwriter section. Its four chips are seeded in
// the default key straight from chords.ts (never hard-coded letters), in the
// canonical I → V → vi → IV order; forge.ts relabels them live on key change
// and reorders them on drag/keyboard. Default to A so the visitor lands on a
// real, recognisable hit ("Someone Like You").
const FORGE_KEY = "A";
const FORGE_CHIPS = chordsForTonic(FORGE_KEY);
---

<Layout title="Every pop song is the same four chords">
  <header class="masthead">
    <nav class="sitenav" aria-label="Sections">
      <a class="sitenav__skip" href="#lineup">Skip to the songs</a>
      <a class="sitenav__mark" href="#hook" aria-label="The Four-Chord Tribune"
        >T</a
      >
      <ul class="sitenav__list">
        <li><a href="#hook">The claim</a></li>
        <li><a href="#lineup">The lineup</a></li>
        <li><a href="#reveal">Align</a></li>
        <li><a href="#forge">Write your own</a></li>
        <li><a href="#verdict">The verdict</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Scene 1 — the front page / the hook -->
    <section class="frontpage" id="hook">
      <p class="edition">
        <span>Vol.&nbsp;IV &mdash; No.&nbsp;vi</span>
        <span>Canberra &middot; Friday 15 August 2026 &middot; Weather: key of C, clear</span>
        <span>Price: one chorus</span>
      </p>

      <p class="nameplate" aria-label="The Four-Chord Tribune">
        The Four-Chord Tribune
      </p>
      <p class="motto">
        All the chords that are fit to print &middot; Music desk special
        investigation
      </p>

      <hr class="rule rule--thickthin" aria-hidden="true" />

      <div class="headline">
        <h1 class="headline__claim">Every pop song is the same four chords.</h1>
        <p class="stamp stamp--extra" aria-hidden="true">
          Extra! &middot; Hear it yourself
        </p>
      </div>

      <p class="subdeck">
        Five chart-toppers caught using one identical move &mdash; and the
        evidence is audible. Our correspondents press the button so you
        don&rsquo;t have to.
      </p>

      <div class="platestrip" aria-hidden="true">
        <span data-degree="I"></span>
        <span data-degree="V"></span>
        <span data-degree="vi"></span>
        <span data-degree="IV"></span>
      </div>

      <div class="frontgrid">
        <div class="frontgrid__lede">
          <p class="lede lede--lead">
            By our music desk. It has long been whispered in green rooms and
            karaoke bars; today this newspaper can confirm it. Jason Mraz, the
            Black Eyed Peas, Adele, U2 and Maroon 5 &mdash; five acts, five
            keys, no shared rehearsal space &mdash; are all playing
            <em>the same four chords in the same order</em>.
          </p>
          <p class="lede">
            The scheme goes by the alias <strong>I V vi IV</strong>. Readers
            unfamiliar with the notation will find a primer below the fold.
            Readers in a hurry may simply press the button and listen.
          </p>
          <div class="hook__actions">
            <button
              class="playbtn playbtn--hero"
              type="button"
              data-play="hero"
              aria-label="Play the four-chord progression"
            >
              <span class="playbtn__glyph" aria-hidden="true">&#9654;</span>
              <span>Play the four chords</span>
            </button>
            <p class="counter" aria-label="Five songs, four chords, one move">
              <span>5 songs</span><span aria-hidden="true">&middot;</span><span
                >4 chords</span
              ><span aria-hidden="true">&middot;</span><span>1 move</span>
            </p>
          </div>
        </div>

        <div class="frontgrid__photo">
          <div class="pressphoto">
            {/* Decorative front-page furniture, so alt="" (removed from the a11y
                tree). Printed as a misregistered CMYK duotone via CSS. */}
            <img
              src={heroPress.src}
              width={heroPress.width}
              height={heroPress.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="pressphoto__caption">
            One spotlight, one crowd, one progression &mdash; printed with the
            plates showing.
          </p>
        </div>

        <div class="frontgrid__wire">
          <p class="wire__label">Fig. 1 &middot; the live signal</p>
          <!-- Decorative live audio visualizer ("the wire"): reacts to whatever
               is playing. Purely presentational (aria-hidden); audio.ts drives
               it off a shared analyser tap. -->
          <canvas
            class="visualizer"
            data-visualizer
            aria-hidden="true"
            width="600"
            height="72"></canvas>
          <p class="wire__caption">
            Fig. 1 &mdash; the four chords as they cross the newsroom wire.
            Colour indicates which of the four slots is sounding.
          </p>

          <nav class="onthispage" aria-label="On this page">
            <p class="onthispage__head">On this page</p>
            <ul>
              <li><a href="#primer">A primer for new readers</a></li>
              <li><a href="#lineup">The evidence</a></li>
              <li><a href="#forge">Write your own hit</a></li>
              <li><a href="#verdict">The verdict</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </section>

    <!-- Scene 1.5 — the primer: everything a zero-music-knowledge visitor needs
         before the lineup makes sense. Native <details open> so it shows by
         default but folds away for anyone who already knows the theory; no JS. -->
    <section class="primer" id="primer">
      <details class="primer__box" open>
        <summary class="primer__summary">
          <h2 class="primer__head">For New Readers</h2>
          <span class="primer__note">
            a sixty-second primer, no instrument required
          </span>
        </summary>

        <div class="primer__body">
          <dl class="primer__glossary">
            <div class="primer__card" data-primer-card data-open>
              <dt class="primer__term">
                <button
                  class="primer__toggle"
                  type="button"
                  data-primer-toggle
                  aria-expanded="true"
                  aria-controls="primer-def-1"
                >
                  <span class="primer__q">What&rsquo;s a chord?</span>
                  <span class="primer__mark" aria-hidden="true"></span>
                </button>
              </dt>
              <dd class="primer__def" id="primer-def-1" data-primer-def>
                <div class="primer__def-inner">
                  A chord is just a few notes played at the same time. Strum a
                  guitar or press three piano keys together &mdash; that&rsquo;s
                  a chord. Almost every song is built from a handful of them,
                  played in a loop.
                </div>
              </dd>
            </div>
            <div class="primer__card" data-primer-card>
              <dt class="primer__term">
                <button
                  class="primer__toggle"
                  type="button"
                  data-primer-toggle
                  aria-expanded="false"
                  aria-controls="primer-def-2"
                >
                  <span class="primer__q"
                    >Why the letters (C, G, Am, F)?</span
                  >
                  <span class="primer__mark" aria-hidden="true"></span>
                </button>
              </dt>
              <dd class="primer__def" id="primer-def-2" data-primer-def>
                <div class="primer__def-inner">
                  Each chord has a name. C, G and F are <em>major</em> chords
                  &mdash; bright and settled. The little <strong>m</strong> in A<strong
                    >m</strong
                  > means <em>minor</em> &mdash; a softer, sadder sound. That&rsquo;s
                  the whole alphabet you need here.
                </div>
              </dd>
            </div>
            <div class="primer__card" data-primer-card>
              <dt class="primer__term">
                <button
                  class="primer__toggle"
                  type="button"
                  data-primer-toggle
                  aria-expanded="false"
                  aria-controls="primer-def-3"
                >
                  <span class="primer__q"
                    >What&rsquo;s a &lsquo;key&rsquo;?</span
                  >
                  <span class="primer__mark" aria-hidden="true"></span>
                </button>
              </dt>
              <dd class="primer__def" id="primer-def-3" data-primer-def>
                <div class="primer__def-inner">
                  A song&rsquo;s <em>key</em> is the note it treats as home
                  &mdash; where it feels like it starts and rests. Move a song
                  to a different key and every chord name changes, but the
                  song sounds exactly the same, just higher or lower &mdash;
                  like singing Happy Birthday starting on a higher note: same
                  tune, different pitch.
                </div>
              </dd>
            </div>
            <div class="primer__card" data-primer-card>
              <dt class="primer__term">
                <button
                  class="primer__toggle"
                  type="button"
                  data-primer-toggle
                  aria-expanded="false"
                  aria-controls="primer-def-4"
                >
                  <span class="primer__q">What are I, V, vi, IV?</span>
                  <span class="primer__mark" aria-hidden="true"></span>
                </button>
              </dt>
              <dd class="primer__def" id="primer-def-4" data-primer-def>
                <div class="primer__def-inner">
                  Instead of names, musicians number the four chords by their
                  <em>job</em> in the song: <strong>I, V, vi, IV</strong> (one,
                  five, six, four). The trick: these numbers stay the same in
                  <em>every</em> key &mdash; they&rsquo;re the four &lsquo;slots&rsquo;
                  the pattern lives in. Notice <strong>vi</strong> is lowercase:
                  it&rsquo;s the one minor chord of the four.
                </div>
              </dd>
            </div>
          </dl>

          <figure class="primer__example">
            <figcaption class="primer__example-title">
              Table 1 &middot; the pattern, worked out
            </figcaption>
            {/* Two keys, same four slots. Each chord chip carries its degree via
                data-degree so it inherits the same plate used across the lineup —
                colour quietly says "same slot" before a word is read. The slot
                numerals are identical in both rows; only the letters differ. */}
            <div class="worked">
              <div class="worked__case">
                <p class="worked__key">
                  In the key of <strong>C</strong>
                </p>
                <div class="worked__chords">
                  <span class="worked__chip" data-degree="I">
                    <span class="worked__letter">C</span>
                    <span class="worked__slot">I</span>
                  </span>
                  <span class="worked__chip" data-degree="V">
                    <span class="worked__letter">G</span>
                    <span class="worked__slot">V</span>
                  </span>
                  <span class="worked__chip" data-degree="vi">
                    <span class="worked__letter">Am</span>
                    <span class="worked__slot">vi</span>
                  </span>
                  <span class="worked__chip" data-degree="IV">
                    <span class="worked__letter">F</span>
                    <span class="worked__slot">IV</span>
                  </span>
                </div>
              </div>
              <div class="worked__case">
                <p class="worked__key">
                  In the key of <strong>G</strong>
                </p>
                <div class="worked__chords">
                  <span class="worked__chip" data-degree="I">
                    <span class="worked__letter">G</span>
                    <span class="worked__slot">I</span>
                  </span>
                  <span class="worked__chip" data-degree="V">
                    <span class="worked__letter">D</span>
                    <span class="worked__slot">V</span>
                  </span>
                  <span class="worked__chip" data-degree="vi">
                    <span class="worked__letter">Em</span>
                    <span class="worked__slot">vi</span>
                  </span>
                  <span class="worked__chip" data-degree="IV">
                    <span class="worked__letter">C</span>
                    <span class="worked__slot">IV</span>
                  </span>
                </div>
              </div>
            </div>
            <figcaption class="worked__caption">
              Different letters &mdash; the same four slots, in the same order,
              with the same feeling.
            </figcaption>
          </figure>

          <p class="primer__punchline">
            Every exhibit below fills those same four slots. They only
            <em>look</em> different because each one sits in its own key. Press
            <strong>Align</strong> in the press room at the foot of the page and
            all five move into one key &mdash; the letters become identical
            while the numbers I V vi IV never move. That&rsquo;s the whole
            story.
          </p>
        </div>
      </details>
    </section>

    <!-- Scene 2 + 3 — the evidence, with the press room docked over it -->
    <section class="stage" data-stage data-aligned="false">
      <div class="lineup" id="lineup">
        <h2 class="section-head">
          The Evidence
          <span class="section-head__note">
            exhibits A through E, printed with their plates showing
          </span>
        </h2>
        <p class="lineup__lede">
          Each song appears in the key it was released in, so the chord letters
          look nothing alike. Read the small constant column beneath each one:
          <strong>I V vi IV</strong>. It never changes. It is the fingerprint on
          all five records.
        </p>

        <ol class="songlist">
          {
            SONGS.map((song, songIndex) => {
              const chords = chordsForTonic(song.tonic);
              return (
                <li
                  class="song"
                  data-song={song.title}
                  data-tonic={song.tonic}
                  data-current-key={song.tonic}
                >
                  <div class="song__cover">
                    <img
                      src={COVERS[songIndex].src}
                      width={COVERS[songIndex].width}
                      height={COVERS[songIndex].height}
                      alt={`${song.title} — ${song.artist} album cover`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>

                  <div class="song__meta">
                    <p class="song__kicker">
                      Exhibit {EXHIBIT(songIndex)} &middot; {song.section}
                    </p>
                    <h3 class="song__title">{song.title}</h3>
                    <p class="song__artist">{song.artist}</p>
                    <p class="song__key">
                      key of <span data-current-key-label>{song.tonic}</span>
                      {/* Plain-language gloss on "key", reusing the chord-role
                          pattern: an operable button names the term, and the
                          explanation lives OUTSIDE [data-current-key-label] as a
                          sibling role="tooltip" (so align.ts, which rewrites the
                          label, can never clobber it). Revealed on hover +
                          keyboard focus purely in CSS; keygloss.ts adds only the
                          tap-to-pin layer. Unique id per song for 1:1
                          aria-describedby. */}
                      <span class="keygloss" data-keygloss>
                        <button
                          class="keygloss__btn"
                          type="button"
                          data-keygloss-toggle
                          aria-expanded="false"
                          aria-describedby={`key-gloss-${songIndex}`}
                          aria-label="What does “key” mean?"
                        >
                          <span aria-hidden="true">&#9432;</span>
                        </button>
                        <span
                          class="keygloss__tip"
                          id={`key-gloss-${songIndex}`}
                          role="tooltip"
                          data-keygloss-tip
                        >
                          <em>n.b.</em> &mdash; the key is the note this song
                          treats as home. Change it and the letters shift; the
                          song stays the same.
                        </span>
                      </span>
                    </p>
                  </div>

                  <div class="song__progression">
                    <div
                      class="chords"
                      data-testid="chords"
                      aria-label={`Chords for ${song.title} in the current key`}
                    >
                      {chords.map((chord) => {
                        // Unique per song+degree so aria-describedby resolves
                        // 1:1 (degree is unique within a song's four chords).
                        const roleId = `chord-role-${songIndex}-${chord.degree}`;
                        return (
                          <div
                            class="chord"
                            data-degree={chord.degree}
                            data-chord-cell
                          >
                            {/* The operable control. Its accessible name is the
                                visible chord letter; the role text is announced
                                via aria-describedby. Keyboard-reachable and
                                Enter/Space-triggerable as a native button. */}
                            <button
                              class="chord__btn"
                              type="button"
                              data-chord-toggle
                              aria-expanded="false"
                              aria-describedby={roleId}
                            >
                              <span class="chord__label" data-chord-label>
                                {chord.label}
                              </span>
                            </button>
                            {/* Role lives OUTSIDE [data-chord-label] as a
                                sibling, so align.ts can never clobber it. Kept
                                in the a11y tree while visually hidden (opacity),
                                so describedby announces it on focus. */}
                            <span
                              class="chord__role"
                              id={roleId}
                              role="tooltip"
                              data-chord-role
                            >
                              {ROLE_COPY[chord.degree]}
                            </span>
                          </div>
                        );
                      })}
                    </div>

                    <div
                      class="roman-row"
                      data-testid="roman-row"
                      aria-label="Roman numerals — constant in every key"
                    >
                      {ROMANS.map((roman) => (
                        <span class="roman" data-degree={roman}>
                          {roman}
                        </span>
                      ))}
                    </div>
                  </div>

                  <button
                    class="playbtn playbtn--song"
                    type="button"
                    data-play={song.title}
                    aria-label={`Play ${song.title}`}
                  >
                    <span class="playbtn__glyph" aria-hidden="true">
                      &#9654;
                    </span>
                    <span>Play</span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>

      <!-- Scene 3 — the press room: the control that snaps every song to one key -->
      <div class="reveal" id="reveal" data-testid="align-control">
        <div class="reveal__inner">
          <div class="reveal__copy">
            {/* The live tally: the whole thesis in one number. Split, the five
                songs print SPLIT_DISTINCT_COUNT (16) different chord names;
                aligned, that collapses to 4 — "the same four, in every song".
                Server-rendered here as the split state (the no-JS fallback);
                align.ts overwrites both number and caption from the exact same
                source that fills the cells (distinctChordNames) on first
                render, so the count provably equals what is on the page. */}
            <p class="reveal__tally" data-tally>
              <span class="reveal__tally-num" data-distinct-count
                >{SPLIT_DISTINCT_COUNT}</span
              >
              <span class="reveal__tally-cap" data-distinct-caption
                >different chord names across the five songs</span
              >
            </p>
            <p class="reveal__label">Press room &middot; Transpose all five to</p>
            <p class="reveal__hint" data-align-status aria-live="polite">
              their own keys
            </p>
            <p class="reveal__note">
              (&ldquo;Transpose&rdquo; just means move every song into the same
              key.)
            </p>
            {/* The payoff: only revealed once [data-stage] flips to
                data-aligned="true" (align.ts sets that attribute; this
                paragraph does no work of its own). Hidden/shown purely by the
                CSS rule pinned to that same attribute in global.css. */}
            <p class="reveal__payoff" data-reveal-payoff>
              Once aligned, the five recordings share not just a key but every
              chord, in order. Press <strong>Play</strong> on any two exhibits
              now &mdash; you are listening to one progression wearing five
              disguises.
            </p>
          </div>
          <div class="reveal__controls">
            <label class="keypicker">
              <span class="keypicker__label">Shared key</span>
              <select class="keypicker__select" data-key-select>
                <option value="__none__">Each song&rsquo;s own key</option>
                {
                  KEYS.map((key) => (
                    <option value={key}>{key} major</option>
                  ))
                }
              </select>
            </label>
            <button class="btn btn--primary" type="button" data-align>
              Align to {ALIGN_KEY}
            </button>
            <button class="btn btn--ghost" type="button" data-reset>
              Split apart
            </button>
            {/* "Hear the collision": plays all five songs' four-chord loops at
                once on one shared clock. It reads each song's CURRENT key, so
                split it's a pile-up and aligned it's one fat unison — the A/B
                the visitor drives. A real <button> with aria-pressed; audio.ts
                toggles it and swaps the glyph/label to the ■ Stop state. */}
            <div class="chorus">
              <span class="chorus__label" aria-hidden="true">
                Hear all five together
              </span>
              <button
                class="btn btn--chorus"
                type="button"
                data-play-all
                aria-pressed="false"
                aria-label="Play all five songs at once"
              >
                <span class="playbtn__glyph" aria-hidden="true">&#9654;</span>
                <span>All Five at Once</span>
              </button>
              <span class="chorus__hint" aria-hidden="true">
                Split, they clash &middot; aligned, they lock into one.
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Scene 3.5 — the payoff: the visitor becomes the songwriter. Same four
         chords, arranged by hand; the page names — honestly — what they built. -->
    <section class="forge" id="forge" data-forge>
      <div class="forge__inner">
        <h2 class="section-head">
          Write Your Own Hit
          <span class="section-head__note">
            you take the desk &mdash; arrange the four, we name the tune
          </span>
        </h2>
        <p class="forge__lede">
          Same four chords, your order. Drag them into any sequence &mdash; or
          focus one and nudge it with the arrow keys &mdash; then pick a key and
          press play. We&rsquo;ll name what you built &mdash; every order lands
          somewhere. The twist: the two loops the world already knows hide inside
          more of these orders than you&rsquo;d expect.
        </p>

        <div class="forge__console">
          <div class="forge__bar">
            <label class="keypicker forge__key">
              <span class="keypicker__label">Your key</span>
              <select class="keypicker__select" data-forge-key>
                {
                  KEYS.map((key) => (
                    <option value={key} selected={key === FORGE_KEY}>
                      {key} major
                    </option>
                  ))
                }
              </select>
            </label>

            <div class="forge__actions">
              <button
                class="playbtn playbtn--forge"
                type="button"
                data-forge-play
                aria-pressed="false"
                aria-label="Play your arrangement"
              >
                <span class="playbtn__glyph" aria-hidden="true">&#9654;</span>
                <span>Play your hit</span>
              </button>
              <button
                class="btn btn--drum"
                type="button"
                data-forge-drum
                aria-pressed="false"
                aria-label="Toggle a drum click on each beat"
              >
                Drum click
              </button>
            </div>
          </div>

          <ol
            class="forge__slots"
            data-forge-slots
            aria-label="Your four-chord arrangement, in order"
          >
            {
              FORGE_CHIPS.map((chord, index) => (
                <li class="forge__slot" data-forge-slot={index}>
                  <span class="forge__slotno" aria-hidden="true">
                    {index + 1}
                  </span>
                  <button
                    class="forge__chip"
                    type="button"
                    data-forge-chip
                    data-degree={chord.degree}
                    aria-label={`Chord ${index + 1} of 4, the ${chord.degree} (${chord.label}). Use arrow keys to reorder.`}
                  >
                    <span class="forge__handle" aria-hidden="true">
                      &#8801;
                    </span>
                    <span class="forge__chip-letter" data-forge-chip-letter>
                      {chord.label}
                    </span>
                    <span class="forge__chip-degree" aria-hidden="true">
                      {chord.roman}
                    </span>
                  </button>
                </li>
              ))
            }
          </ol>

          {/* The recognition payoff. Updated live by forge.ts as the order or
              key changes; aria-live so screen readers hear the new verdict. */}
          <div
            class="forge__verdict"
            data-forge-verdict
            role="status"
            aria-live="polite"
          >
            <p class="forge__verdict-kicker" aria-hidden="true">
              The desk&rsquo;s verdict
            </p>
            <p class="forge__verdict-name" data-forge-verdict-name>The Axis</p>
            <p class="forge__verdict-body" data-forge-verdict-body>
              The most-used order in pop. I &rarr; V &rarr; vi &rarr; IV.
            </p>
            <p class="forge__verdict-songs" data-forge-verdict-songs>
              In the key of A, that&rsquo;s the exact progression under
              &ldquo;Someone Like You&rdquo; (Adele).
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scene 4 — the verdict -->
    <section class="verdict" id="verdict">
      <p class="verdict__pov">
        Case closed. The letters change. The move doesn&rsquo;t.
      </p>
      <p class="verdict__sub">
        Now you&rsquo;ll hear it everywhere &mdash; on the radio, in the
        supermarket, at the wedding. You&rsquo;re welcome, and we&rsquo;re
        sorry.
      </p>
      <p class="counter counter--verdict">
        <span>5 songs</span><span aria-hidden="true">&middot;</span><span
          >4 chords</span
        ><span aria-hidden="true">&middot;</span><span>1 move</span><span
          aria-hidden="true">&middot;</span
        ><span>Corrections: none &mdash; we checked twice</span>
      </p>
      <p class="stamp stamp--confirmed" aria-hidden="true">Confirmed</p>
    </section>
  </main>

  <script src="../scripts/align.ts"></script>
  <script src="../scripts/audio.ts"></script>
  <script src="../scripts/roles.ts"></script>
  <script src="../scripts/keygloss.ts"></script>
  <script src="../scripts/primer.ts"></script>
  <script src="../scripts/forge.ts"></script>
</Layout>
