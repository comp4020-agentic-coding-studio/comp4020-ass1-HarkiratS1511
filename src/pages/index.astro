---
import Layout from "../layouts/Layout.astro";
import { SONGS } from "../data/songs";
import { ALIGN_KEY, chordsForTonic, type Degree } from "../lib/chords";

// The keys the visitor can transpose every song to. Conventional lead-sheet
// spellings (mixed sharps/flats) so the shared-key readout matches how a
// musician would write it — the same order chords.ts uses internally.
const KEYS = [
  "C",
  "Db",
  "D",
  "Eb",
  "E",
  "F",
  "F#",
  "G",
  "Ab",
  "A",
  "Bb",
  "B",
] as const;

// Degree order is the thesis: every song, every key, always I → V → vi → IV.
const ROMANS = ["I", "V", "vi", "IV"] as const;

// What each chord *does* — its role is degree-based, so it's identical in every
// key and every song. Keyed on degree, this copy is rendered once per chord and
// revealed on demand (hover / focus / tap); it is NEVER written into
// [data-chord-label], which align.ts owns and overwrites on every align.
const ROLE_COPY: Record<Degree, string> = {
  I: "Home. Where the song rests.",
  V: "Tension. It leans forward, wanting to resolve.",
  vi: "The turn. The wistful, minor-key step.",
  IV: "The lift. It opens the song back up.",
};
---

<Layout title="Every pop song is the same four chords">
  <header class="masthead">
    <nav class="sitenav" aria-label="Sections">
      <a class="sitenav__skip" href="#lineup">Skip to the songs</a>
      <ul class="sitenav__list">
        <li><a href="#hook">The claim</a></li>
        <li><a href="#lineup">The lineup</a></li>
        <li><a href="#reveal">Align</a></li>
        <li><a href="#verdict">The verdict</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Scene 1 — the hook -->
    <section class="hook" id="hook">
      <p class="kicker">One progression · Five songs</p>
      <h1 class="hook__headline">Every pop song is the same four chords.</h1>
      <p class="hook__support">Here&rsquo;s the proof &mdash; you can hear it.</p>
      <div class="hook__actions">
        <button
          class="playbtn playbtn--hero"
          type="button"
          data-play="hero"
          aria-label="Play the four-chord progression"
        >
          <span class="playbtn__glyph" aria-hidden="true">&#9654;</span>
          <span>Play the four chords</span>
        </button>
        <p class="counter" aria-label="Five songs, four chords, one move">
          <span>5 songs</span><span aria-hidden="true">·</span><span
            >4 chords</span
          ><span aria-hidden="true">·</span><span>1 move</span>
        </p>
      </div>
      <!-- Decorative live audio visualizer: a calm waveform / beat pulse that
           reacts to whatever is playing. Purely presentational (aria-hidden);
           audio.ts drives it off a shared analyser tap. -->
      <canvas
        class="visualizer"
        data-visualizer
        aria-hidden="true"
        width="600"
        height="72"></canvas>
    </section>

    <!-- Scene 1.5 — the primer: everything a zero-music-knowledge visitor needs
         before the lineup makes sense. Native <details open> so it shows by
         default but folds away for anyone who already knows the theory; no JS. -->
    <section class="primer" id="primer">
      <details class="primer__box" open>
        <summary class="primer__summary">
          <span class="primer__summary-text">New here? Start with this</span>
          <span class="primer__summary-note" aria-hidden="true"
            >a 60-second crash course</span
          >
        </summary>

        <div class="primer__body">
          <dl class="primer__glossary">
            <div class="primer__card">
              <dt class="primer__term">What&rsquo;s a chord?</dt>
              <dd class="primer__def">
                A chord is just a few notes played at the same time. Strum a
                guitar or press three piano keys together &mdash; that&rsquo;s a
                chord. Almost every song is built from a handful of them, played
                in a loop.
              </dd>
            </div>
            <div class="primer__card">
              <dt class="primer__term">Why the letters (C, G, Am, F)?</dt>
              <dd class="primer__def">
                Each chord has a name. C, G and F are <em>major</em> chords
                &mdash; bright and settled. The little <strong>m</strong> in A<strong
                  >m</strong
                > means <em>minor</em> &mdash; a softer, sadder sound. That&rsquo;s
                the whole alphabet you need here.
              </dd>
            </div>
            <div class="primer__card">
              <dt class="primer__term">What&rsquo;s a &lsquo;key&rsquo;?</dt>
              <dd class="primer__def">
                A song&rsquo;s <em>key</em> is the note it treats as home &mdash;
                where it feels like it starts and rests. Move a song to a
                different key and every chord name changes, but the song sounds
                exactly the same, just higher or lower &mdash; like singing Happy
                Birthday starting on a higher note: same tune, different pitch.
              </dd>
            </div>
            <div class="primer__card">
              <dt class="primer__term">What are I, V, vi, IV?</dt>
              <dd class="primer__def">
                Instead of names, musicians number the four chords by their
                <em>job</em> in the song: <strong>I, V, vi, IV</strong> (one,
                five, six, four). The trick: these numbers stay the same in
                <em>every</em> key &mdash; they&rsquo;re the four &lsquo;slots&rsquo;
                the pattern lives in. Notice <strong>vi</strong> is lowercase: it&rsquo;s
                the one minor chord of the four.
              </dd>
            </div>
          </dl>

          <figure class="primer__example">
            <figcaption class="primer__example-title">
              The pattern, worked out
            </figcaption>
            {/* Two keys, same four slots. Each chord chip carries its degree via
                data-degree so it inherits the same hue used across the lineup —
                colour quietly says "same slot" before a word is read. The slot
                numerals are identical in both rows; only the letters differ. */}
            <div class="worked">
              <div class="worked__case">
                <p class="worked__key">
                  In the key of <strong>C</strong>
                </p>
                <div class="worked__chords">
                  <span class="worked__chip" data-degree="I">
                    <span class="worked__slot">I</span>
                    <span class="worked__letter">C</span>
                  </span>
                  <span class="worked__chip" data-degree="V">
                    <span class="worked__slot">V</span>
                    <span class="worked__letter">G</span>
                  </span>
                  <span class="worked__chip" data-degree="vi">
                    <span class="worked__slot">vi</span>
                    <span class="worked__letter">Am</span>
                  </span>
                  <span class="worked__chip" data-degree="IV">
                    <span class="worked__slot">IV</span>
                    <span class="worked__letter">F</span>
                  </span>
                </div>
              </div>
              <div class="worked__case">
                <p class="worked__key">
                  In the key of <strong>G</strong>
                </p>
                <div class="worked__chords">
                  <span class="worked__chip" data-degree="I">
                    <span class="worked__slot">I</span>
                    <span class="worked__letter">G</span>
                  </span>
                  <span class="worked__chip" data-degree="V">
                    <span class="worked__slot">V</span>
                    <span class="worked__letter">D</span>
                  </span>
                  <span class="worked__chip" data-degree="vi">
                    <span class="worked__slot">vi</span>
                    <span class="worked__letter">Em</span>
                  </span>
                  <span class="worked__chip" data-degree="IV">
                    <span class="worked__slot">IV</span>
                    <span class="worked__letter">C</span>
                  </span>
                </div>
              </div>
            </div>
            <figcaption class="worked__caption">
              Different letters &mdash; but the same four slots, in the same
              order, with the same feeling.
            </figcaption>
          </figure>

          <p class="primer__punchline">
            Every song below is filling those same four slots. They only
            <em>look</em> different because each one sits in its own key. Press
            <strong>Align</strong> (or drag the key slider) and they all move into
            one key &mdash; the letters become identical while the numbers I V vi
            IV never move. That&rsquo;s the whole point.
          </p>
        </div>
      </details>
    </section>

    <!-- Scene 2 + 3 — the lineup, with the align toolbar docked over it -->
    <section class="stage" data-stage data-aligned="false">
      <div class="lineup" id="lineup">
        <p class="lineup__lede">
          Here are five hit songs, each in the key it was released in &mdash; so
          the chord letters look nothing alike. But look at the row of numbers
          under each one: <strong>I V vi IV</strong>, the four &lsquo;slots&rsquo;
          from above. Those never change. That&rsquo;s the shape every song
          shares.
        </p>

        <ol class="songlist">
          {
            SONGS.map((song, songIndex) => {
              const chords = chordsForTonic(song.tonic);
              return (
                <li
                  class="song"
                  data-song={song.title}
                  data-tonic={song.tonic}
                  data-current-key={song.tonic}
                >
                  <div class="song__meta">
                    <h2 class="song__title">{song.title}</h2>
                    <p class="song__artist">{song.artist}</p>
                    <p class="song__section">{song.section}</p>
                    <p class="song__key">
                      key of <span data-current-key-label>{song.tonic}</span>
                      {/* Plain-language gloss on "key", reusing the chord-role
                          pattern: an operable button names the term, and the
                          explanation lives OUTSIDE [data-current-key-label] as a
                          sibling role="tooltip" (so align.ts, which rewrites the
                          label, can never clobber it). Revealed on hover +
                          keyboard focus purely in CSS; keygloss.ts adds only the
                          tap-to-pin layer. Unique id per song for 1:1
                          aria-describedby. */}
                      <span class="keygloss" data-keygloss>
                        <button
                          class="keygloss__btn"
                          type="button"
                          data-keygloss-toggle
                          aria-expanded="false"
                          aria-describedby={`key-gloss-${songIndex}`}
                          aria-label="What does “key” mean?"
                        >
                          <span aria-hidden="true">&#9432;</span>
                        </button>
                        <span
                          class="keygloss__tip"
                          id={`key-gloss-${songIndex}`}
                          role="tooltip"
                          data-keygloss-tip
                        >
                          The note this song treats as home. Change it and the
                          chord letters shift, but the song stays the same.
                        </span>
                      </span>
                    </p>
                  </div>

                  <div class="song__progression">
                    <div
                      class="chords"
                      data-testid="chords"
                      aria-label={`Chords for ${song.title} in the current key`}
                    >
                      {chords.map((chord) => {
                        // Unique per song+degree so aria-describedby resolves
                        // 1:1 (degree is unique within a song's four chords).
                        const roleId = `chord-role-${songIndex}-${chord.degree}`;
                        return (
                          <div
                            class="chord"
                            data-degree={chord.degree}
                            data-chord-cell
                          >
                            {/* The operable control. Its accessible name is the
                                visible chord letter; the role text is announced
                                via aria-describedby. Keyboard-reachable and
                                Enter/Space-triggerable as a native button. */}
                            <button
                              class="chord__btn"
                              type="button"
                              data-chord-toggle
                              aria-expanded="false"
                              aria-describedby={roleId}
                            >
                              <span class="chord__label" data-chord-label>
                                {chord.label}
                              </span>
                            </button>
                            {/* Role lives OUTSIDE [data-chord-label] as a
                                sibling, so align.ts can never clobber it. Kept
                                in the a11y tree while visually hidden (opacity),
                                so describedby announces it on focus. */}
                            <span
                              class="chord__role"
                              id={roleId}
                              role="tooltip"
                              data-chord-role
                            >
                              {ROLE_COPY[chord.degree]}
                            </span>
                          </div>
                        );
                      })}
                    </div>

                    <div
                      class="roman-row"
                      data-testid="roman-row"
                      aria-label="Roman numerals — constant in every key"
                    >
                      {ROMANS.map((roman) => (
                        <span class="roman" data-degree={roman}>
                          {roman}
                        </span>
                      ))}
                    </div>
                  </div>

                  <button
                    class="playbtn playbtn--song"
                    type="button"
                    data-play={song.title}
                    aria-label={`Play ${song.title}`}
                  >
                    <span class="playbtn__glyph" aria-hidden="true">
                      &#9654;
                    </span>
                    <span>Play</span>
                  </button>
                </li>
              );
            })
          }
        </ol>
      </div>

      <!-- Scene 3 — the reveal: the control that snaps every song to one key -->
      <div class="reveal" id="reveal" data-testid="align-control">
        <div class="reveal__inner">
          <div class="reveal__copy">
            <p class="reveal__label">Transpose all five to</p>
            <p class="reveal__hint" data-align-status aria-live="polite">
              their own keys
            </p>
            <p class="reveal__note">
              (&ldquo;Transpose&rdquo; just means move every song into the same
              key.)
            </p>
          </div>
          <div class="reveal__controls">
            {/* Key-morph slider: scrub to transpose all five songs continuously
                through the 12 keys. Its 12 positions map 1:1 to KEYS above
                (0 = "C" … 11 = "B"); align.ts reads the integer and drives the
                same alignTo() path as the select and button. Labelled + a live
                readout; aria-valuetext is set to the key name so screen readers
                announce "C major", not "0 of 11". */}
            <div class="keyscrub">
              <label class="keyscrub__label" for="key-slider">
                Scrub through keys
              </label>
              <input
                id="key-slider"
                class="keyscrub__slider"
                type="range"
                min="0"
                max="11"
                step="1"
                value="0"
                data-key-slider
                aria-valuetext="C major"
              />
              <span
                class="keyscrub__readout"
                data-key-readout
                aria-hidden="true">C major</span
              >
            </div>
            <label class="keypicker">
              <span class="keypicker__label">Shared key</span>
              <select class="keypicker__select" data-key-select>
                <option value="__none__">Each song&rsquo;s own key</option>
                {
                  KEYS.map((key) => (
                    <option value={key}>{key} major</option>
                  ))
                }
              </select>
            </label>
            <button class="btn btn--primary" type="button" data-align>
              Align to {ALIGN_KEY}
            </button>
            <button class="btn btn--ghost" type="button" data-reset>
              Split apart
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Scene 4 — the verdict + counter -->
    <section class="verdict" id="verdict">
      <p class="verdict__pov">
        The letters change. The move doesn&rsquo;t. Now you&rsquo;ll hear it
        everywhere.
      </p>
      <p class="counter counter--verdict">
        <span>5 songs</span><span aria-hidden="true">·</span><span>4 chords</span
        ><span aria-hidden="true">·</span><span>1 move</span>
      </p>
    </section>
  </main>

  <script src="../scripts/align.ts"></script>
  <script src="../scripts/audio.ts"></script>
  <script src="../scripts/roles.ts"></script>
  <script src="../scripts/keygloss.ts"></script>
</Layout>
